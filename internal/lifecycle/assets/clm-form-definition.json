{
  "schemaVersion": 1,
  "name": "New Contract Request",
  "destinationFolderId": "${box.folders.intake}",
  "confirmationBehavior": "box-default",
  "provisioning": {
    "mode": "authenticated-browser-ui",
    "existingFormPolicy": "reconcile-exact-title",
    "saveForm": true,
    "publishLink": false,
    "share": false
  },
  "fields": [
    {
      "key": "requesterName",
      "label": "Requester name",
      "type": "shortText",
      "required": true,
      "rehearsalValue": "Jordan Lee"
    },
    {
      "key": "requesterEmail",
      "label": "Requester email",
      "type": "email",
      "required": true,
      "rehearsalValue": "jordan.lee@acmerobotics.example"
    },
    {
      "key": "contractId",
      "label": "Contract ID",
      "type": "shortText",
      "required": true,
      "rehearsalValue": "CLM-2026-0017"
    },
    {
      "key": "counterparty",
      "label": "Counterparty",
      "type": "shortText",
      "required": true,
      "rehearsalValue": "Northstar Health System"
    },
    {
      "key": "contractType",
      "label": "Contract type",
      "type": "dropdown",
      "required": true,
      "options": [
        "MSA Package",
        "DPA",
        "SOW",
        "Order Form",
        "Procurement Agreement"
      ],
      "rehearsalValue": "MSA Package"
    },
    {
      "key": "dealValue",
      "label": "Deal value",
      "type": "number",
      "required": true,
      "rehearsalValue": 2400000
    },
    {
      "key": "contractTermMonths",
      "label": "Contract term months",
      "type": "number",
      "required": true,
      "rehearsalValue": 36
    },
    {
      "key": "region",
      "label": "Region",
      "type": "dropdown",
      "required": true,
      "options": [
        "US",
        "EU",
        "APAC",
        "Global"
      ],
      "rehearsalValue": "US"
    },
    {
      "key": "dataCategory",
      "label": "Data category",
      "type": "dropdown",
      "required": true,
      "options": [
        "None",
        "Personal Data",
        "PHI",
        "Financial Data",
        "Confidential"
      ],
      "rehearsalValue": "PHI"
    },
    {
      "key": "targetSignatureDate",
      "label": "Target signature date",
      "type": "date",
      "required": true,
      "rehearsalValue": "future rehearsal-safe date"
    },
    {
      "key": "businessOwner",
      "label": "Business owner",
      "type": "shortText",
      "required": true,
      "rehearsalValue": "Account Executive"
    },
    {
      "key": "contractPackage",
      "label": "Upload contract package",
      "type": "fileUpload",
      "required": true,
      "rehearsalValue": "northstar-msa-redline-v3.pdf"
    },
    {
      "key": "riskNotes",
      "label": "Special terms / risk notes",
      "type": "longText",
      "required": false,
      "rehearsalValue": "Review liability, PHI, and Net 90 triggers."
    }
  ]
}
