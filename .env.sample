# Box Dispatch — local environment template
#
# Copy this file to .env and fill in the values for the providers you use.
# .env is gitignored; never commit real tokens. `box-dispatch setup` can also
# write/refresh a .env for you. Only the providers in your scenario need values.

# ─── Box ────────────────────────────────────────────────────────────────────
# OAuth2 refresh-token credentials. Alternatively, add a CCG app from the
# interactive Connect > Box screen; Dispatch stores that app locally (0600).
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_REFRESH_TOKEN=
# Folder that holds the packaged provider configuration (Box provider object id).
BOX_FOLDER_ID=
# Parent folder the deployment workspace is created under (omit to use the
# configured default; folder "0" / root is refused unless the override below).
BOX_PARENT_FOLDER_ID=
# Name for the deployment workspace folder.
BOX_WORKSPACE_NAME=
# Admin user the workspace is provisioned for (informational / setup-managed).
BOX_ADMIN_USER=
# Set to "true" only to permit deploying into the root folder. Leave unset.
BOX_ALLOW_ROOT_FOLDER=
# Optional: named configuration profile (defaults to "default").
BOX_DISPATCH_PROFILE=

# ─── Salesforce ─────────────────────────────────────────────────────────────
# Legacy `sf` CLI org alias. Existing terminal workflows may still use this
# while provider deployment is migrated to direct Metadata API calls.
SF_ALIAS=
# REST connection used by the Go backend to check the selected org.
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
# Dev Hub REST connection used to create replacement scratch orgs in the web
# app. The Connected App callback must allow http://localhost:1717/OauthRedirect.
SALESFORCE_DEV_HUB_URL=
SALESFORCE_DEV_HUB_ACCESS_TOKEN=
SALESFORCE_CLIENT_ID=
# Optional when the Connected App does not require a client secret.
SALESFORCE_CLIENT_SECRET=

# ─── Databricks ─────────────────────────────────────────────────────────────
# Workspace URL, e.g. https://dbc-xxxxxxxx.cloud.databricks.com
DATABRICKS_HOST=
# Personal access token for the workspace.
DATABRICKS_TOKEN=
# Named profile in ~/.databrickscfg. The Go tool reads DATABRICKS_PROFILE; the
# databricks CLI reads DATABRICKS_CONFIG_PROFILE — set whichever you rely on.
DATABRICKS_PROFILE=
DATABRICKS_CONFIG_PROFILE=
# Workspace label (informational / setup-managed).
DATABRICKS_WORKSPACE=

# ─── AWS (Bedrock AgentCore) ────────────────────────────────────────────────
# Named profile in ~/.aws/credentials.
AWS_PROFILE=
# Region for AgentCore. AWS_REGION takes precedence over AWS_DEFAULT_REGION.
AWS_REGION=
AWS_DEFAULT_REGION=
