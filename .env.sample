# Box Dispatch — local environment template
#
# Copy this file to .env and fill in the values for the providers you use.
# .env is gitignored; never commit real tokens. Only the providers in your
# scenario need values.

# ─── Box ────────────────────────────────────────────────────────────────────
# Browser login. Add this callback on the Box app:
#   http://localhost:4400/oauth/callback
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
# Optional headless bootstrap if you already have a refresh token.
BOX_REFRESH_TOKEN=
# Folder that holds the packaged provider configuration (Box object id).
BOX_FOLDER_ID=
# Parent folder for the deployment workspace. Folder "0" is refused unless
# BOX_ALLOW_ROOT_FOLDER=true.
BOX_PARENT_FOLDER_ID=
BOX_WORKSPACE_NAME=
BOX_ALLOW_ROOT_FOLDER=
# Named configuration profile (defaults to "default").
BOX_DISPATCH_PROFILE=

# ─── Salesforce ─────────────────────────────────────────────────────────────
# Browser login uses Salesforce's public PlatformCLI client. No consumer key.
# Optional alias for the terminal checker and legacy CLI workflows.
SF_ALIAS=

# ─── Databricks ─────────────────────────────────────────────────────────────
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_PROFILE=

# ─── AWS (Bedrock AgentCore) ────────────────────────────────────────────────
AWS_PROFILE=
# AWS_REGION takes precedence over AWS_DEFAULT_REGION.
AWS_REGION=
AWS_DEFAULT_REGION=
