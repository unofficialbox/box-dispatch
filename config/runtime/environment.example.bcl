{
  "activeScenario": "clm",
  "scenarios": {
    "clm": {
      "displayName": "Contract Lifecycle Management",
      "sector": "LEGAL OPERATIONS",
      "description": "Content-centric contract workflows with Box and intelligent agents.",
      "repository": "https://github.com/unofficialbox/box-bedrock-for-clm",
      "providers": [
        "box",
        "salesforce-agentforce",
        "databricks",
        "bedrock-agentcore"
      ],
      "notes": [
        "Standard CLM deployment flow",
        "Use this scenario for a baseline multi-provider rollout"
      ]
    },
    "lifesciences": {
      "displayName": "Life Sciences",
      "sector": "REGULATED CONTENT",
      "description": "Accelerate document-heavy life sciences processes and insight.",
      "repository": "https://github.com/unofficialbox/box-bedrock-for-lifesciences",
      "providers": [
        "box",
        "salesforce-agentforce",
        "databricks",
        "bedrock-agentcore"
      ],
      "notes": [
        "Reference scenario for regulated workloads"
      ]
    },
    "citizen-services": {
      "displayName": "Citizen Services",
      "sector": "PUBLIC SECTOR",
      "description": "Modernize constituent intake, case content, and service delivery.",
      "repository": "https://github.com/unofficialbox/box-bedrock-for-citizen-services",
      "providers": [
        "box",
        "salesforce-agentforce",
        "databricks",
        "bedrock-agentcore"
      ],
      "notes": [
        "Reference scenario for public sector constituent services"
      ]
    }
  },
  "providers": {
    "box": {
      "displayName": "Box",
      "role": "Content, unstructured data, and AI",
      "env": {
        "BOX_ACCESS_TOKEN": "${BOX_ACCESS_TOKEN}",
        "BOX_FOLDER_ID": "${BOX_FOLDER_ID}",
        "BOX_ENTERPRISE_ID": "${BOX_ENTERPRISE_ID}"
      },
      "variables": {
        "scope": "environment",
        "artifactRoot": "clm"
      }
    },
    "salesforce-agentforce": {
      "displayName": "Salesforce",
      "role": "CRM, structured records, and customer workflows",
      "env": {
        "SF_ALIAS": "${SF_ALIAS}",
        "SF_PROJECT_DIR": "${SF_PROJECT_DIR}",
        "SF_ORG_ID": "${SF_ORG_ID}"
      },
      "variables": {
        "platform": "agentforce",
        "namespace": "clm"
      }
    },
    "databricks": {
      "displayName": "Databricks",
      "role": "Analytics, models, and data intelligence",
      "env": {
        "DATABRICKS_HOST": "${DATABRICKS_HOST}",
        "DATABRICKS_TOKEN": "${DATABRICKS_TOKEN}"
      },
      "variables": {
        "workspace": "clm-${AWS_REGION}",
        "catalog": "clm_catalog"
      }
    },
    "bedrock-agentcore": {
      "displayName": "AWS Bedrock AgentCore",
      "role": "Agent runtime and orchestration",
      "env": {
        "AWS_PROFILE": "${AWS_PROFILE}",
        "AWS_REGION": "${AWS_REGION}",
        "AGENTCORE_AGENT_NAME": "${AGENTCORE_AGENT_NAME}",
        "AGENTCORE_RUNTIME_NAME": "${AGENTCORE_RUNTIME_NAME}"
      },
      "variables": {
        "region": "${AWS_REGION}",
        "environment": "clm"
      }
    }
  }
}
