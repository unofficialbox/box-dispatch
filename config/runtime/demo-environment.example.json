{
  "activeScenario": "box-agentforce-databricks-agentcore",
  "scenarios": {
    "box-agentforce-databricks-agentcore": {
      "displayName": "Box + Salesforce Agentforce + Databricks + Bedrock AgentCore",
      "providers": [
        "box",
        "salesforce-agentforce",
        "databricks",
        "bedrock-agentcore"
      ],
      "notes": [
        "Run `windlass setup` before any other command",
        "Use --allow-unresolved when intentionally leaving placeholders for manual setup"
      ]
    }
  },
  "providers": {
    "box": {
      "displayName": "Box",
      "env": {
        "BOX_ACCESS_TOKEN": "${BOX_ACCESS_TOKEN}",
        "BOX_ADMIN_USER": "${BOX_ADMIN_USER}",
        "BOX_FOLDER_ID": "${BOX_FOLDER_ID}"
      },
      "variables": {
        "seedPrefix": "${SCENARIO_NAME}-box"
      }
    },
    "salesforce-agentforce": {
      "displayName": "Salesforce Agentforce",
      "env": {
        "SF_ALIAS": "${SF_ALIAS}",
        "SF_PROJECT_DIR": "${SF_PROJECT_DIR}",
        "AGENTFORCE_PACKAGE_PATH": "${AGENTFORCE_PACKAGE_PATH}"
      },
      "variables": {
        "agentRole": "agentic-demo"
      }
    },
    "databricks": {
      "displayName": "Databricks",
      "env": {
        "DATABRICKS_HOST": "${DATABRICKS_HOST}",
        "DATABRICKS_TOKEN": "${DATABRICKS_TOKEN}",
        "DATABRICKS_WORKSPACE": "${DATABRICKS_WORKSPACE}"
      },
      "variables": {
        "catalog": "hive_metastore",
        "schema": "agentic_demo"
      }
    },
    "bedrock-agentcore": {
      "displayName": "AWS Bedrock AgentCore",
      "env": {
        "AWS_PROFILE": "${AWS_PROFILE}",
        "AWS_REGION": "${AWS_REGION}",
        "AGENTCORE_AGENT_NAME": "${AGENTCORE_AGENT_NAME}"
      },
      "variables": {
        "agentRuntime": "demo-runtime"
      }
    }
  }
}
